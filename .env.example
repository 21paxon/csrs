# Neon: Dashboard > Connection Details > copy the connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Optional: set to "false" to disable student/staff self-registration
ALLOW_SELF_REGISTER=true
# Optional SMS gateway (leave blank to log SMS to console)
SMS_API_URL=
SMS_API_KEY=
MAX_UPLOAD_MB=20
