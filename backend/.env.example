PORT=3000
# Neon pooled PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
FRONTEND_ORIGINS=http://localhost:3000,https://your-frontend-domain.example
PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Admin account for npm run seed:admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rpmusanze.ac.rw
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional registration setting
ALLOW_SELF_REGISTER=true

# Optional SMS gateway
SMS_API_URL=
SMS_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=
PUSH_API_URL=
PUSH_API_KEY=
VAPID_PUBLIC_KEY=
BACKGROUND_WORKER_INTERVAL_MS=5000
CSRS_BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

# Upload configuration
MAX_UPLOAD_MB=20
